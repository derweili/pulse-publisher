---
import { sections, sectionPath } from "../data";
import SearchTrigger from "./SearchTrigger.tsx";
import MobileMenu from "./MobileMenu.tsx";
import { Show, SignInButton, UserButton } from "@clerk/astro/components";

const navSections = sections;
---

<header
  class="sticky top-0 z-[100] border-b border-border bg-white/92 backdrop-blur-[14px] backdrop-saturate-[180%]"
  id="site-header"
>
  <div
    class="container-page-wide flex h-header items-center gap-5"
  >
    <div class="shrink-0 max-[960px]:flex-1">
      <a href="/" class="inline-flex items-center gap-2 font-display text-[26px] leading-none tracking-[0.02em]" aria-label="PULSE home">
        <span class="grid size-[30px] max-[480px]:size-[26px] place-items-center rounded-sm bg-primary text-[20px] max-[480px]:text-[17px] text-white">P</span>
        <span class="text-ink max-[480px]:text-[22px]">PULSE</span>
      </a>
    </div>

    <nav class="mx-auto flex items-center gap-1 max-[960px]:hidden" aria-label="Sections">
      <a href="/" class="rounded-[8px] px-3 py-2 text-sm font-bold tracking-[0.02em] text-ink-2 transition-colors duration-200 ease-brand hover:bg-primary-soft hover:text-primary">Home</a>
      {navSections.map((s) => (
        <a
          href={sectionPath(s.slug)}
          class="rounded-[8px] px-3 py-2 text-sm font-bold tracking-[0.02em] text-ink-2 transition-colors duration-200 ease-brand hover:bg-primary-soft hover:text-primary"
          data-section={s.slug}
        >
          {s.name}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-2.5">
      <SearchTrigger sections={navSections} client:idle />
      <a
        href="/subscribe"
        class="rounded-full bg-ink px-4 py-2.5 text-[13px] font-bold tracking-[0.02em] text-white transition-all duration-200 ease-brand hover:-translate-y-px hover:bg-primary max-[960px]:hidden"
        >Subscribe</a
      >
      <Show when="signed-out">
        <SignInButton
          mode="modal"
          class="rounded-full border border-border bg-transparent px-4 py-2.5 text-[13px] font-bold tracking-[0.02em] text-ink transition-all duration-200 ease-brand hover:-translate-y-px hover:border-ink"
        />
      </Show>
      <Show when="signed-in">
        <UserButton />
      </Show>
      <button
        class="hidden max-[960px]:flex h-10 w-10 flex-col justify-center gap-1.5 rounded border border-border bg-transparent px-[9px] py-2.5"
        id="menu-open-btn"
        aria-label="Open menu"
        aria-controls="mobile-menu"
      >
        <span class="h-0.5 rounded-[2px] bg-ink transition-all duration-200 ease-brand"></span>
        <span class="h-0.5 rounded-[2px] bg-ink transition-all duration-200 ease-brand"></span>
        <span class="h-0.5 rounded-[2px] bg-ink transition-all duration-200 ease-brand"></span>
      </button>
    </div>
  </div>
  <MobileMenu sections={navSections} client:idle />
</header>
