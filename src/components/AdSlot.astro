---
interface Props {
  slot?: string;
  label?: string;
  format?: "leaderboard" | "mpu" | "rectangle" | "in-article" | "native-in-feed" | "skyscraper" | "sticky";
  class?: string;
}
const {
  slot = "ad",
  label = "Advertisement",
  format = "rectangle",
  class: className = "",
} = Astro.props;

const sizeMap: Record<string, { w: string; h: string; minH: string }> = {
  leaderboard: { w: "728px", h: "90px", minH: "90px" },
  mpu: { w: "300px", h: "250px", minH: "250px" },
  rectangle: { w: "300px", h: "250px", minH: "250px" },
  "in-article": { w: "100%", h: "250px", minH: "120px" },
  "native-in-feed": { w: "100%", h: "auto", minH: "0" },
  skyscraper: { w: "300px", h: "600px", minH: "600px" },
  sticky: { w: "320px", h: "50px", minH: "50px" },
};
const s = sizeMap[format] ?? sizeMap.rectangle;
---

<aside
  class={`ad-slot ad-${format} ${className}`}
  data-ad-slot={slot}
  role="complementary"
  aria-label={label}
  style={`--ad-w:${s.w};--ad-h:${s.h};--ad-min-h:${s.minH}`}
>
  <div class="ad-inner">
    <span class="ad-label">{label}</span>
    <span class="ad-slot-name">{slot}</span>
    {format === "native-in-feed" ? (
      <div class="ad-native">
        <span class="ad-native-tag">Sponsored</span>
        <span class="ad-native-title">A message from our partner</span>
        <span class="ad-native-cta">Learn more →</span>
      </div>
    ) : (
      <span class="ad-placeholder">{s.w} × {s.h}</span>
    )}
  </div>
</aside>

<style>
  .ad-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: var(--ad-min-h);
    margin-inline: auto;
  }
  .ad-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: var(--ad-w);
    max-width: 100%;
    min-height: var(--ad-min-h);
    padding: 14px;
    background: repeating-linear-gradient(
      45deg,
      var(--color-bg-soft),
      var(--color-bg-soft) 10px,
      var(--color-bg-muted) 10px,
      var(--color-bg-muted) 20px
    );
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    color: var(--color-ink-4);
    text-align: center;
  }
  .ad-label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-5);
  }
  .ad-slot-name {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-ink-5);
    background: rgba(255,255,255,0.7);
    padding: 2px 7px;
    border-radius: 4px;
  }
  .ad-placeholder {
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--color-ink-5);
    opacity: 0.8;
  }
  .ad-native {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    text-align: left;
    padding: 4px 6px;
  }
  .ad-native-tag {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-5);
  }
  .ad-native-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-ink-2);
  }
  .ad-native-cta {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-primary);
  }

  .ad-leaderboard .ad-inner { width: 728px; height: 90px; }
  .ad-mpu .ad-inner,
  .ad-rectangle .ad-inner { width: 300px; height: 250px; }
  .ad-in-article .ad-inner { width: 100%; height: 250px; }
  .ad-skyscraper .ad-inner { width: 300px; height: 600px; }

  @media (max-width: 768px) {
    .ad-leaderboard .ad-inner { width: 100%; height: 100px; }
    .ad-in-article .ad-inner { height: 200px; }
    .ad-skyscraper { display: none; }
  }
</style>
