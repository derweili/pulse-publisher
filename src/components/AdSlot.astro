---
interface Props {
  slot?: string;
  label?: string;
  format?: "leaderboard" | "mpu" | "rectangle" | "in-article" | "native-in-feed" | "skyscraper" | "sticky";
  class?: string;
}
const {
  slot = "ad",
  label = "Advertisement",
  format = "rectangle",
  class: className = "",
} = Astro.props;

const sizeMap: Record<string, { w: string; h: string }> = {
  leaderboard: { w: "728px", h: "90px" },
  mpu: { w: "300px", h: "250px" },
  rectangle: { w: "300px", h: "250px" },
  "in-article": { w: "100%", h: "250px" },
  "native-in-feed": { w: "100%", h: "auto" },
  skyscraper: { w: "300px", h: "600px" },
  sticky: { w: "320px", h: "50px" },
};
const s = sizeMap[format] ?? sizeMap.rectangle;

const outerClasses: Record<string, string> = {
  skyscraper: "max-md:hidden",
};
const innerClasses: Record<string, string> = {
  leaderboard: "w-[728px] h-[90px] min-h-[90px] max-md:w-full max-md:h-[100px]",
  mpu: "w-[300px] h-[250px] min-h-[250px]",
  rectangle: "w-[300px] h-[250px] min-h-[250px]",
  "in-article": "w-full h-[250px] min-h-[120px] max-md:h-[200px]",
  "native-in-feed": "w-full min-h-0",
  skyscraper: "w-[300px] h-[600px] min-h-[600px]",
  sticky: "w-[320px] min-h-[50px]",
};
---

<aside
  class={`flex w-full items-center justify-center mx-auto ${innerClasses[format] ? "" : "min-h-[250px]"} ${outerClasses[format] ?? ""} ${className}`}
  data-ad-slot={slot}
  role="complementary"
  aria-label={label}
>
  <div
    class={`ad-inner flex max-w-full flex-col items-center justify-center gap-1.5 rounded-lg border border-dashed border-border-strong bg-[repeating-linear-gradient(45deg,var(--color-bg-soft),var(--color-bg-soft)_10px,var(--color-bg-muted)_10px,var(--color-bg-muted)_20px)] p-3.5 text-center text-ink-4 ${innerClasses[format] ?? innerClasses.rectangle}`}
  >
    <span class="text-[9px] font-bold tracking-[0.14em] text-ink-5 uppercase">{label}</span>
    <span class="rounded-[4px] bg-white/70 px-1.5 py-0.5 font-mono text-[10px] text-ink-5">{slot}</span>
    {format === "native-in-feed" ? (
      <div class="flex w-full flex-col gap-1.5 px-1.5 py-1 text-left">
        <span class="text-[10px] font-extrabold tracking-[0.1em] text-ink-5 uppercase">Sponsored</span>
        <span class="text-[15px] font-bold text-ink-2">A message from our partner</span>
        <span class="text-[13px] font-bold text-primary">Learn more →</span>
      </div>
    ) : (
      <span class="font-mono text-xs text-ink-5 opacity-80">{s.w} × {s.h}</span>
    )}
  </div>
</aside>
