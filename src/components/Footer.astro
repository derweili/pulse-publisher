---
import { sections, sectionPath, authors, authorPath } from "../data";
import Newsletter from "./Newsletter.astro";

const year = new Date().getFullYear();
---

<footer class="mt-16 bg-ink text-[#d7dadf]">
  <div class="border-b border-[#22232a] bg-[linear-gradient(180deg,#15161a,#0a0a0b)] py-14">
    <div class="container-page">
      <Newsletter
        title="The daily dispatch"
        subtitle="One email each morning. The stories that matter, the ones that are about to. Free."
        variant="footer"
      />
    </div>
  </div>

  <div class="container-page-wide grid grid-cols-[1.2fr_2fr] gap-12 py-14 max-[860px]:grid-cols-1 max-[860px]:gap-9">
    <div>
      <a href="/" class="inline-flex items-center gap-2 font-display text-[28px] tracking-[0.02em] text-white">
        <span class="grid size-[30px] place-items-center rounded-sm bg-primary text-[20px] text-white">P</span>
        <span>PULSE</span>
      </a>
      <p class="mt-4 max-w-[340px] text-sm leading-relaxed text-[#9aa0a8]">
        Modern news, bold takes. Built for people who'd rather think than scroll.
      </p>
    </div>

    <div class="grid grid-cols-4 gap-6 max-[860px]:grid-cols-2 max-[860px]:gap-x-5 max-[860px]:gap-y-7">
      <div>
        <h4 class="mb-4 text-xs font-extrabold tracking-[0.12em] text-white uppercase">Sections</h4>
        <ul>
          {sections.map((s) => (
            <li class="mb-2.5">
              <a href={sectionPath(s.slug)} class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">{s.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="mb-4 text-xs font-extrabold tracking-[0.12em] text-white uppercase">Voice</h4>
        <ul>
          {authors.slice(0, 4).map((a) => (
            <li class="mb-2.5">
              <a href={authorPath(a.slug)} class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">{a.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="mb-4 text-xs font-extrabold tracking-[0.12em] text-white uppercase">Company</h4>
        <ul>
          <li class="mb-2.5"><a href="/about" class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">About</a></li>
          <li class="mb-2.5"><a href="/contact" class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">Contact</a></li>
          <li class="mb-2.5"><a href="/advertise" class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">Advertise</a></li>
          <li class="mb-2.5"><a href="/subscribe" class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">Subscribe</a></li>
        </ul>
      </div>
      <div>
        <h4 class="mb-4 text-xs font-extrabold tracking-[0.12em] text-white uppercase">Legal</h4>
        <ul>
          <li class="mb-2.5"><a href="/privacy" class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">Privacy</a></li>
          <li class="mb-2.5"><a href="/terms" class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">Terms</a></li>
          <li class="mb-2.5"><a href="/cookies" class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">Cookies</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container-page-wide flex items-center justify-between gap-4 border-t border-[#22232a] py-5 text-xs text-[#6b7280] max-[480px]:flex-col max-[480px]:items-start max-[480px]:gap-1.5">
    <p>© {year} PULSE Media. All rights reserved.</p>
    <p>Made with bold caffeine.</p>
  </div>
</footer>
