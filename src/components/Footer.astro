---
import { authorPath, sectionPath } from "../lib/paths";
import { getSanityClient } from "../lib/sanity/client";
import { getAuthors, getSections, getSiteSettings } from "../lib/sanity/fetch";
import Newsletter from "./Newsletter.astro";

const client = getSanityClient(Astro.locals.runtime.env);
const [sections, authors, settings] = await Promise.all([
  getSections(client),
  getAuthors(client),
  getSiteSettings(client),
]);

const year = new Date().getFullYear();
const copyright = settings.copyrightText || `© ${year} ${settings.title}. All rights reserved.`;

const resolveHref = (link: { linkType: "internal" | "external"; internalHref: string | null; externalUrl: string | null }) =>
  link.linkType === "internal" && link.internalHref ? sectionPath(link.internalHref) : (link.externalUrl ?? "#");
---

<footer class="mt-16 bg-ink text-[#d7dadf]">
  <div class="border-b border-[#22232a] bg-[linear-gradient(180deg,#15161a,#0a0a0b)] py-14">
    <div class="container-page">
      <Newsletter
        title="The daily dispatch"
        subtitle="One email each morning. The stories that matter, the ones that are about to. Free."
        variant="footer"
      />
    </div>
  </div>

  <div class="container-page-wide grid grid-cols-[1.2fr_2fr] gap-12 py-14 max-[860px]:grid-cols-1 max-[860px]:gap-9">
    <div>
      <a href="/" class="inline-flex items-center gap-2 font-display text-[28px] tracking-[0.02em] text-white">
        <span class="grid size-[30px] place-items-center rounded-sm bg-primary text-[20px] text-white">{settings.title.charAt(0)}</span>
        <span>{settings.title}</span>
      </a>
      <p class="mt-4 max-w-[340px] text-sm leading-relaxed text-[#9aa0a8]">
        {settings.tagline}
      </p>
      {settings.socialLinks && settings.socialLinks.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-3">
          {settings.socialLinks.map((social) => (
            <li>
              <a href={social.url} class="text-xs font-semibold uppercase tracking-[0.08em] text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">
                {social.platform}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="grid grid-cols-4 gap-6 max-[860px]:grid-cols-2 max-[860px]:gap-x-5 max-[860px]:gap-y-7">
      <div>
        <h4 class="mb-4 text-xs font-extrabold tracking-[0.12em] text-white uppercase">Sections</h4>
        <ul>
          {sections.map((s) => (
            <li class="mb-2.5">
              <a href={sectionPath(s.slug)} class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">{s.title}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="mb-4 text-xs font-extrabold tracking-[0.12em] text-white uppercase">Voice</h4>
        <ul>
          {authors.slice(0, 4).map((a) => (
            <li class="mb-2.5">
              <a href={authorPath(a.slug)} class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">{a.name}</a>
            </li>
          ))}
        </ul>
      </div>
      {(settings.footerLinkGroups ?? []).map((group) => (
        <div>
          <h4 class="mb-4 text-xs font-extrabold tracking-[0.12em] text-white uppercase">{group.heading}</h4>
          <ul>
            {(group.links ?? []).map((link) => (
              <li class="mb-2.5">
                <a href={resolveHref(link)} class="text-sm text-[#9aa0a8] transition-colors duration-200 ease-brand hover:text-primary">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="container-page-wide flex items-center justify-between gap-4 border-t border-[#22232a] py-5 text-xs text-[#6b7280] max-[480px]:flex-col max-[480px]:items-start max-[480px]:gap-1.5">
    <p>{copyright}</p>
    <div class="flex items-center gap-4">
      <a href="/rss.xml" class="font-semibold uppercase tracking-[0.08em] transition-colors duration-200 ease-brand hover:text-primary">RSS</a>
      <p>Made with bold caffeine.</p>
    </div>
  </div>
</footer>
