---
interface Props {
  title?: string;
  subtitle?: string;
  variant?: "inline" | "footer" | "compact";
}
const {
  title = "Join the PULSE list",
  subtitle = "Get the stories that matter, every morning. Free, no spam, unsubscribe anytime.",
  variant = "inline",
} = Astro.props;
---

<section class={`newsletter newsletter-${variant}`} data-newsletter>
  <div class="nl-inner">
    {variant !== "compact" && (
      <div class="nl-text">
        <div class="nl-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <rect x="3" y="5" width="18" height="14" rx="2"/>
            <path d="m3 7 9 6 9-6"/>
          </svg>
        </div>
        <div>
          <h3 class="nl-title">{title}</h3>
          <p class="nl-subtitle">{subtitle}</p>
        </div>
      </div>
    )}
    <form class="nl-form" data-nl-form>
      {variant === "compact" && (
        <p class="nl-compact-label">{title}</p>
      )}
      <input
        type="email"
        class="nl-input"
        placeholder="you@example.com"
        aria-label="Email address"
        required
      />
      <button type="submit" class="nl-button">Subscribe</button>
    </form>
    <p class="nl-success" data-nl-success hidden>
      You're on the list. Check your inbox for a confirmation.
    </p>
    <p class="nl-error" data-nl-error hidden>
      Please enter a valid email address.
    </p>
  </div>
</section>

<script>
  function initNewsletter(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>("[data-nl-form]");
    const success = root.querySelector<HTMLElement>("[data-nl-success]");
    const error = root.querySelector<HTMLElement>("[data-nl-error]");
    if (!form || !success || !error) return;
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>("input[type=email]");
      if (!input) return;
      const value = input.value.trim();
      const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      if (!valid) {
        error.hidden = false;
        success.hidden = true;
        return;
      }
      error.hidden = true;
      success.hidden = false;
      form.hidden = true;
    });
  }
  document.querySelectorAll<HTMLElement>("[data-newsletter]").forEach(initNewsletter);
</script>

<style>
  .newsletter {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .newsletter-inline {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
  }
  .newsletter-inline .nl-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 24px;
    align-items: center;
    padding: 28px;
  }
  .newsletter-footer .nl-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 28px;
    align-items: center;
    padding: 8px 0;
  }
  .newsletter-compact {
    background: var(--color-ink);
    color: #fff;
  }
  .newsletter-compact .nl-inner { padding: 18px 20px; }
  .nl-text { display: flex; gap: 16px; align-items: center; }
  .nl-icon {
    display: grid; place-items: center;
    width: 44px; height: 44px;
    background: var(--color-primary);
    color: #fff;
    border-radius: 12px;
    flex-shrink: 0;
  }
  .newsletter-inline .nl-title { font-size: 20px; }
  .newsletter-inline .nl-subtitle { font-size: 14px; color: var(--color-ink-3); margin-top: 4px; }
  .newsletter-footer .nl-title { font-size: 24px; color: #fff; }
  .newsletter-footer .nl-subtitle { font-size: 14px; color: #9aa0a8; margin-top: 6px; max-width: 46ch; }
  .newsletter-footer .nl-icon { background: var(--color-primary); }

  .nl-form {
    display: flex;
    gap: 8px;
    width: 100%;
  }
  .nl-compact-label { font-size: 13px; font-weight: 700; margin-bottom: 8px; color: #fff; }
  .nl-input {
    flex: 1;
    min-width: 0;
    padding: 13px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: #fff;
    font-size: 14px;
    color: var(--color-ink);
  }
  .newsletter-footer .nl-input { border-color: #33343c; background: #15161a; color: #fff; }
  .newsletter-footer .nl-input::placeholder { color: #6b7280; }
  .nl-input:focus { outline: none; border-color: var(--color-primary); }
  .nl-button {
    padding: 13px 20px;
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: background var(--transition), transform var(--transition);
  }
  .nl-button:hover { background: var(--color-primary-dark); transform: translateY(-1px); }

  .nl-success, .nl-error { font-size: 13px; padding-top: 4px; }
  .nl-success { color: var(--color-success); font-weight: 600; }
  .nl-error { color: var(--color-error); font-weight: 600; }
  .newsletter-footer .nl-success { color: #4ade80; }
  .newsletter-footer .nl-error { color: #fca5a5; }

  @media (max-width: 720px) {
    .newsletter-inline .nl-inner,
    .newsletter-footer .nl-inner {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .nl-form { flex-direction: column; }
    .nl-button { width: 100%; }
  }
</style>
