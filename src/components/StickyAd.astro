---
import AdSlot from "./AdSlot.astro";
---

<script>
  const STICKY_AD_SLOT_NAME = "sticky-footer";

  function setupStickyAd() {
    const ad = document.querySelector<HTMLElement>("[data-sticky-ad]");
    const sentinel = document.querySelector<HTMLElement>("[data-sticky-ad-sentinel]");
    const closeBtn = document.querySelector<HTMLButtonElement>("[data-sticky-ad-close]");
    if (!ad || !sentinel) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            ad.dataset.visible = "false";
          } else {
            if (sessionStorage.getItem(`ad-dismissed-${STICKY_AD_SLOT_NAME}`) === "1") return;
            ad.dataset.visible = "true";
          }
        });
      },
      { rootMargin: "0px", threshold: 0 }
    );
    observer.observe(sentinel);

    closeBtn?.addEventListener("click", () => {
      ad.dataset.visible = "false";
      sessionStorage.setItem(`ad-dismissed-${STICKY_AD_SLOT_NAME}`, "1");
    });
  }

  setupStickyAd();
</script>

<div class="relative -mb-px h-px w-full" data-sticky-ad-sentinel></div>
<div
  class="fixed inset-x-0 bottom-0 z-[90] translate-y-[110%] pointer-events-none transition-transform duration-[350ms] ease-brand data-[visible=true]:translate-y-0 data-[visible=true]:pointer-events-auto"
  data-sticky-ad
  data-visible="false"
>
  <div class="sticky-ad-inner relative mx-auto max-w-(--container-content) px-4 pb-[calc(8px+env(safe-area-inset-bottom,0px))] pl-[calc(16px+env(safe-area-inset-left,0px))] pr-[calc(16px+env(safe-area-inset-right,0px))]">
    <button class="absolute -top-1.5 right-2 z-2 grid size-[26px] place-items-center rounded-full border-2 border-white bg-ink text-white" data-sticky-ad-close aria-label="Close ad">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <div class="sticky-ad-content overflow-hidden rounded-xl border border-border bg-bg-soft shadow-lg">
      <slot />
    </div>
  </div>
</div>

<style>
  .sticky-ad-content :global(.pulse-slot-inner) {
    width: 100% !important;
    height: 60px !important;
    min-height: 60px !important;
    border: none;
    background: var(--color-bg-soft);
  }
  @media (max-width: 768px) {
    .sticky-ad-content :global(.pulse-slot-inner) {
      height: 56px !important;
    }
  }
</style>
