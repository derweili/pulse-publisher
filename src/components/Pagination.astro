---
interface Props {
  page: number;
  pages: number;
  basePath: string;
  queryKey?: string;
}
const { page, pages, basePath, queryKey = "page" } = Astro.props;

const max = pages;
const cur = page;
const range: (number | "…")[] = [];
if (max <= 7) {
  for (let i = 1; i <= max; i++) range.push(i);
} else {
  range.push(1);
  if (cur > 3) range.push("…");
  const start = Math.max(2, cur - 1);
  const end = Math.min(max - 1, cur + 1);
  for (let i = start; i <= end; i++) range.push(i);
  if (cur < max - 2) range.push("…");
  range.push(max);
}

const href = (p: number) =>
  p === 1 ? basePath : `${basePath}${basePath.includes("?") ? "&" : "?"}${queryKey}=${p}`;

const prev = cur > 1 ? href(cur - 1) : null;
const next = cur < max ? href(cur + 1) : null;

const numberBase =
  "inline-grid min-w-10 h-10 max-[560px]:min-w-9 max-[560px]:h-9 place-items-center rounded px-2.5 text-sm max-[560px]:text-[13px] font-bold";
const edgeBase =
  "inline-flex h-10 items-center gap-1.5 rounded border border-border bg-surface px-3.5 max-[560px]:px-2.5 text-[13px] font-bold text-ink-2 transition-all duration-200 ease-brand";
---

{max > 1 && (
  <nav class="mt-10 flex flex-wrap items-center justify-center gap-2" aria-label="Pagination">
    {prev ? (
      <a class={`${edgeBase} hover:border-ink hover:bg-ink hover:text-white`} href={prev} rel="prev">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M15 6l-6 6 6 6"/></svg>
        <span class="max-[560px]:hidden">Prev</span>
      </a>
    ) : (
      <span class={`${edgeBase} cursor-not-allowed opacity-40`} aria-disabled="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M15 6l-6 6 6 6"/></svg>
        <span class="max-[560px]:hidden">Prev</span>
      </span>
    )}

    <ul class="flex items-center gap-1 max-[560px]:gap-0.5">
      {range.map((r) =>
        r === "…" ? (
          <li class={`${numberBase} text-ink-4`}>…</li>
        ) : r === cur ? (
          <li><span class={`${numberBase} bg-primary text-white`} aria-current="page">{r}</span></li>
        ) : (
          <li><a class={`${numberBase} border border-border bg-surface text-ink-2 transition-all duration-200 ease-brand hover:border-ink hover:bg-ink hover:text-white`} href={href(r)}>{r}</a></li>
        )
      )}
    </ul>

    {next ? (
      <a class={`${edgeBase} hover:border-ink hover:bg-ink hover:text-white`} href={next} rel="next">
        <span class="max-[560px]:hidden">Next</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
      </a>
    ) : (
      <span class={`${edgeBase} cursor-not-allowed opacity-40`} aria-disabled="true">
        <span class="max-[560px]:hidden">Next</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
      </span>
    )}
  </nav>
)}
