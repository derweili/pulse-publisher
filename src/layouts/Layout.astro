---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyAd from "../components/StickyAd.astro";

interface Props {
  title?: string;
  description?: string;
  activeSection?: string;
  narrow?: boolean;
}

const {
  title = "PULSE — Modern news, bold takes.",
  description = "PULSE is a young, bold publisher covering tech, culture, science, sports and business.",
  activeSection,
  narrow = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="m-0 text-base leading-normal antialiased">
    <a
      href="#main"
      class="absolute left-4 -top-12 z-[200] rounded-[8px] bg-ink px-4 py-2.5 text-[13px] font-bold text-white transition-[top] duration-200 focus:top-4"
      >Skip to content</a
    >
    <Header activeSection={activeSection} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyAd />
  </body>
</html>
