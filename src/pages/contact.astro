---
import AdSlot from "../components/AdSlot.astro";
import Layout from "../layouts/Layout.astro";

const channels = [
  {
    title: "Newsroom tips",
    description: "Have a story we should look into? Tell us what you know.",
    email: "tips@pulse.example",
  },
  {
    title: "Corrections",
    description: "Spotted an error in a story? See our corrections policy for details.",
    email: "corrections@pulse.example",
    href: "/corrections",
  },
  {
    title: "Advertising & partnerships",
    description: "Media kits, sponsorships and native placements.",
    email: "ads@pulse.example",
  },
  {
    title: "General inquiries",
    description: "Anything else — press, permissions, syndication.",
    email: "hello@pulse.example",
  },
];
---

<Layout
  title="Contact & Tips — PULSE"
  description="Reach the PULSE newsroom: story tips, corrections, advertising and general inquiries."
>
  <div class="container-page-wide flex justify-center pt-4 pb-2">
    <AdSlot slot="leaderboard-top" format="leaderboard" label="Advertisement" />
  </div>

  <section class="container-page max-w-[720px] pt-10 pb-14">
    <span class="eyebrow eyebrow-accent">About PULSE</span>
    <h1 class="section-title mt-2 text-[clamp(28px,4.5vw,40px)]">Contact & tips</h1>
    <p class="mt-5 text-[17px] leading-relaxed text-ink-3">
      The right inbox gets you a faster answer. Pick the one that fits below — or if you're a source with
      something sensitive, read the note on secure tips first.
    </p>

    <div class="mt-9 grid grid-cols-2 gap-5 max-sm:grid-cols-1">
      {channels.map((c) => (
        <div class="rounded-lg border border-border p-5">
          <h2 class="text-base font-extrabold text-ink">{c.title}</h2>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-3">{c.description}</p>
          <a href={`mailto:${c.email}`} class="mt-3 inline-block text-sm font-bold text-primary hover:underline">{c.email}</a>
          {c.href && (
            <a href={c.href} class="mt-1 block text-xs font-semibold text-ink-4 hover:text-primary">Read the policy →</a>
          )}
        </div>
      ))}
    </div>

    <div class="mt-9 rounded-lg border border-border bg-bg-soft p-6">
      <h2 class="text-base font-extrabold text-ink">Sending us a sensitive tip</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-3">
        If what you're sharing could put you at risk, avoid your work email and work network. Include
        only what you're comfortable sharing at first — a reporter will follow up with more secure
        options for anything that needs it.
      </p>
    </div>
  </section>
</Layout>
