# Clerk authentication
# Get this value from https://dashboard.clerk.com → your app → API Keys
# This is the site's only Clerk build/runtime dependency: the site is fully
# static (see wrangler.toml), so auth runs entirely client-side via Clerk's
# browser SDK — no CLERK_SECRET_KEY is needed.
PUBLIC_CLERK_PUBLISHABLE_KEY=

# Sanity CMS
# Project ID and dataset from https://sanity.io/manage → your project → Settings.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Dated API version — see https://www.sanity.io/docs/api-versioning. Bump
# deliberately; don't just set it to "today" on every change.
PUBLIC_SANITY_API_VERSION=2025-02-01
# Read token, required because the dataset is private. Generate at
# sanity.io/manage → API → Tokens with "Viewer" permission. Used only at
# build time (getStaticPaths/frontmatter) — the site is fully static, so
# this never ships to the browser bundle.
SANITY_API_READ_TOKEN=
