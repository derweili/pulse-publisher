# Sanity Studio — get these from https://www.sanity.io/manage → your project → Settings
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Write access for the one-off content migration script only
# (scripts/migrate-content.ts). Generate at sanity.io/manage → API → Tokens
# with "Editor" permission. Never prefix this with SANITY_STUDIO_ — that
# prefix is exposed to the Studio's client bundle, and this must not be.
SANITY_API_WRITE_TOKEN=
