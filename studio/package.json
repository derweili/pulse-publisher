    "@sanity/vision": "^6.9.2",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "sanity": "^6.9.2",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
