{
  "name": "pulse-publisher",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/site",
    "apps/edge",
    "studio"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/site",
    "build": "npm run build -w apps/site",
    "preview": "npm run preview -w apps/site",
    "check": "npm run check -w apps/site",
    "cf:preview": "npm run cf:preview -w apps/site",
    "deploy": "npm run deploy -w apps/site",
    "studio:dev": "npm --prefix studio run dev",
    "studio:deploy": "npm --prefix studio run deploy",
    "studio:typegen": "npm --prefix studio run typegen",
    "studio:migrate": "npm --prefix studio run migrate"
  }
}
