# Cloudflare Worker runtime secrets for local dev.
#
# Copy to `.dev.vars` and fill it in. Read by `wrangler dev` — it mirrors
# what you'd set in production with `wrangler secret put MOS_SECRET_KEY`.

# MonetizationOS secret key, format `sk_<env>_<suffix>`, from the mOS
# console (Session 5 of docs/mos-integration-plan.md provisions this).
#
# A placeholder value (anything non-empty, e.g. `sk_test_placeholder`) is
# enough to test pass-through/plumbing locally: a bad or fake key makes the
# surface-decisions API call fail, and @monetizationos/proxy fails open —
# it logs a warning and serves the origin response untouched rather than
# breaking the site. Real surface decisions need a real key.
MOS_SECRET_KEY=

# SITE_DEV_ORIGIN deliberately does NOT belong in this file. It's the fast
# HMR dev loop's escape hatch from the SITE service binding (see
# src/siteFetch.ts) — putting it here would risk it being forgotten and
# left set when running the prod-like `preview:full` script, silently
# skipping the real service-binding path it's meant to test. It's injected
# only via `wrangler dev --var SITE_DEV_ORIGIN:http://localhost:4321`, i.e.
# the root `dev:full` script — never via a file.
