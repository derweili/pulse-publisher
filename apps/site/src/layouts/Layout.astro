---
import "../styles/global.css";
import BreakingNewsBanner from "../components/BreakingNewsBanner.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import StickyAd from "../components/StickyAd.astro";
import StructuredData from "../components/StructuredData.astro";
import { getEmdashClient } from "../lib/emdash/client";
import { urlFor } from "../lib/emdash/image";
import { getSiteSettings } from "../lib/emdash/content";

interface Props {
  title?: string;
  description?: string;
  activeSection?: string;
  ogImageUrl?: string;
  /** mOS targeting: what kind of page this is. Omitted on pages mOS doesn't target (static pages, tag listings, live blogs). */
  pageType?: "homepage" | "category" | "author" | "article";
  /** mOS targeting: only set on `pageType="article"`. */
  articleType?: "standard" | "premium";
  /** mOS targeting: tags assigned to the current article. */
  tags?: string[];
  /** mOS targeting: categories (sections) the current page belongs to. */
  categories?: string[];
  /** mOS targeting: authors assigned to the current article. */
  authors?: string[];
}

const {
  title = "PULSE — Modern news, bold takes.",
  description = "PULSE is a young, bold publisher covering tech, culture, science, sports and business.",
  activeSection,
  ogImageUrl,
  pageType,
  articleType,
  tags,
  categories,
  authors,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

const client = getEmdashClient(Astro.locals.runtime.env);
const settings = await getSiteSettings(client);
const siteOrigin = (Astro.site ?? Astro.url).origin;
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: settings.title,
  description: settings.tagline,
  url: siteOrigin,
};
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: settings.title,
  url: siteOrigin,
  ...(settings.logo && { logo: urlFor(settings.logo).width(512).height(512).fit("crop").url() }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />

    {pageType && <meta name="mos-page-type" content={pageType} />}
    {articleType && <meta name="mos-article-type" content={articleType} />}
    {categories && categories.length > 0 && <meta name="mos-categories" content={categories.join(",")} />}
    {tags && tags.length > 0 && <meta name="mos-tags" content={tags.join(",")} />}
    {authors && authors.length > 0 && <meta name="mos-authors" content={authors.join(",")} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <StructuredData data={[websiteSchema, organizationSchema]} />
  </head>
  <body class="m-0 text-base leading-normal antialiased">
    <a
      href="#main"
      class="absolute left-4 -top-12 z-[200] rounded-[8px] bg-ink px-4 py-2.5 text-[13px] font-bold text-white transition-[top] duration-200 focus:top-4"
      >Skip to content</a
    >
    {settings.breakingNews?.active && settings.breakingNews.headline && (
      <BreakingNewsBanner headline={settings.breakingNews.headline} href={settings.breakingNews.href} />
    )}
    <Header activeSection={activeSection} />
    <div data-mos="meter-strip"></div>
    <!--
      Runtime contract, not cosmetic — see docs/mos-selectors.md. Default
      value "unproxied" means no mOS behaviour has touched this element yet
      (local dev, a direct origin request, or a missing/misconfigured
      behaviour); it must stay reader-independent here in the origin HTML,
      same as every other data-mos hook. mOS overwrites the text content per
      plan; ../lib/auth-reconcile.ts mirrors these three string values.
    -->
    <div data-mos="auth-state" hidden>unproxied</div>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyAd />
    <CookieConsent />
    <script>
      import { $clerkStore, $userStore } from "@clerk/astro/client";
      import { clearGuard, reconcile, readGuard, writeGuard, type ServerAuthState } from "../lib/auth-reconcile";
      import { dispatchMosAction, resolveAction } from "../lib/mos-actions";

      // Delegated listener for injected mOS creative — see docs/mos-selectors.md's
      // `data-mos-action` section. No script ships inside the creative itself
      // (load order + CSP); this is the one document-level handler that opens
      // the Clerk modal on its behalf, falling back to the link's own `href`
      // whenever the action is unknown or Clerk hasn't loaded yet.
      document.addEventListener("click", (e) => {
        const el = e.target as Element | null;
        if (!el) return;

        const clerk = $clerkStore.get();
        const action = resolveAction(el, !!clerk?.loaded);
        if (!action || !clerk) return;

        e.preventDefault();
        dispatchMosAction(action, clerk);
      });

      const raw = document.querySelector('[data-mos="auth-state"]')?.textContent?.trim();
      const serverState: ServerAuthState = raw === "anonymous" || raw === "signed-in" ? raw : "unproxied";

      if (serverState === "unproxied" && import.meta.env.DEV) {
        console.info(
          '[mos] auth-state marker is "unproxied" — no mOS proxy in front of this ' +
            "response, so auth reconciliation is disabled. Expected in local dev."
        );
      }

      // $userStore is `undefined` until Clerk has resolved the session — only
      // `null` (resolved, signed out) or a UserResource (resolved, signed in)
      // are trustworthy. Coercing `undefined` straight to `!!user === false`
      // was the actual cause of a signed-in-only reload loop: every
      // unresolved reading looked identical to "signed out", so it kept
      // mismatching a `signed-in` server state and re-triggering reconcile()
      // (which itself never unsubscribed) long after the real answer had
      // already arrived. Reconciliation is a page-load-time concern — it
      // must run once, against the first settled reading, then stop; a
      // reader signing out later via UserButton must not cause this to
      // re-fire mid-page.
      let settled = false;
      let unsubscribe: (() => void) | undefined;
      unsubscribe = $userStore.subscribe((user) => {
        if (settled || user === undefined) return;
        settled = true;
        unsubscribe?.();

        const action = reconcile({
          serverState,
          clientSignedIn: !!user,
          alreadyRetried: readGuard(),
        });

        if (action === "rearm") clearGuard();
        if (action === "reload" && writeGuard()) location.reload();
      });
    </script>
  </body>
</html>
