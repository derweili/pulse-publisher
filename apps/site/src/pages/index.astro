---
import AdSlot from "../components/AdSlot.astro";
import ArticleCard from "../components/ArticleCard.astro";
import ForYouRail from "../components/ForYouRail.tsx";
import Newsletter from "../components/Newsletter.astro";
import TrendingList from "../components/TrendingList.astro";
import Layout from "../layouts/Layout.astro";
import { sectionPath } from "../lib/paths";
import { getSanityClient } from "../lib/sanity/client";
import { timeAgo } from "../lib/format";
import { liveBlogPath } from "../lib/paths";
import {
  getActiveLiveBlogs,
  getAllArticles,
  getFeaturedArticles,
  getPremiumArticles,
  getSections,
  getTrendingArticles,
} from "../lib/sanity/fetch";

const client = getSanityClient(Astro.locals.runtime.env);
const [featured, premiumsAll, allSections, allArticles, trending, activeLiveBlogs] = await Promise.all([
  getFeaturedArticles(client),
  getPremiumArticles(client),
  getSections(client),
  getAllArticles(client),
  getTrendingArticles(client),
  getActiveLiveBlogs(client),
]);

// Curation counts vary with real content, so this degrades gracefully
// instead of assuming a fixed number of featured/premium articles exist.
const heroArticle = featured[0] ?? allArticles[0];

const featuredPool = featured.filter((a) => a._id !== heroArticle?._id);
const heroSecondary = featuredPool.slice(0, 2);
const editorsPicksFeatured = featuredPool.slice(2, 4);

const pickedIds = new Set(
  [heroArticle, ...heroSecondary, ...editorsPicksFeatured]
    .filter((a): a is NonNullable<typeof a> => Boolean(a))
    .map((a) => a._id)
);
const editorsPicksBackfill = allArticles
  .filter((a) => !pickedIds.has(a._id))
  .slice(0, 4 - editorsPicksFeatured.length);
const editorsPicks = [...editorsPicksFeatured, ...editorsPicksBackfill];

const premiums = premiumsAll.slice(0, 3);
const sectionsForHome = allSections.slice(0, 4);
const sectionArticleLists = new Map(
  sectionsForHome.map((s) => [
    s.slug,
    allArticles.filter((a) => a.section?.slug === s.slug),
  ])
);
---

<Layout pageType="homepage">
  <div class="container-page-wide flex justify-center pt-4 pb-2">
    <AdSlot slot="leaderboard-top" format="leaderboard" label="Advertisement" />
  </div>

  {activeLiveBlogs.length > 0 && (
    <div class="container-page pt-2">
      {activeLiveBlogs.map((lb) => (
        <a href={liveBlogPath(lb.slug)} class="group flex flex-wrap items-center gap-3 rounded-lg border border-error/30 bg-error/5 px-5 py-3.5 transition-colors duration-200 hover:bg-error/10">
          <span class="inline-flex shrink-0 items-center gap-1.5 rounded-sm bg-error px-2 py-1 text-[10px] font-extrabold tracking-[0.1em] text-white uppercase">
            <span class="relative flex size-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-75"></span>
              <span class="relative inline-flex size-1.5 rounded-full bg-white"></span>
            </span>
            Live
          </span>
          <span class="min-w-0 flex-1 truncate text-sm font-bold text-ink group-hover:text-error">{lb.title}</span>
          <span class="shrink-0 text-xs font-semibold text-ink-4">Updated {timeAgo(lb.startedAt)} · Follow along →</span>
        </a>
      ))}
    </div>
  )}

  <!-- HERO -->
  {heroArticle && (
    <section class="container-page pt-6">
      <div class="grid grid-cols-[1.5fr_1fr] items-start gap-8 max-[960px]:grid-cols-1 max-[960px]:gap-6">
        <div>
          <ArticleCard article={heroArticle} variant="hero" />
        </div>
        <div class="grid grid-cols-1 gap-5 max-[960px]:grid-cols-2 max-[560px]:grid-cols-1">
          {heroSecondary.map((a) => (
            <ArticleCard article={a} variant="default" showDek={false} />
          ))}
        </div>
      </div>
    </section>
  )}

  {trending.length > 0 && (
    <section class="container-page mt-12">
      <div class="max-w-md rounded-lg border border-border bg-bg-soft p-6">
        <TrendingList articles={trending} />
      </div>
    </section>
  )}

  <!-- Quick newsletter -->
  <section class="container-page mt-16">
    <Newsletter
      title="The morning PULSE"
      subtitle="Five stories, every weekday, that are actually worth your attention."
      variant="inline"
    />
  </section>

  <!-- Featured by section -->
  {sectionsForHome.map((section, idx) => {
    const sectionArticles = sectionArticleLists.get(section.slug) ?? [];
    if (sectionArticles.length === 0) return null;
    const lead = sectionArticles[0];
    const rest = sectionArticles.slice(1, 5);
    return (
      <section class="container-page mt-16">
        <div class="section-head">
          <div>
            <span class="eyebrow" style={`color:${section.accentColor}`}>Section</span>
            <h2 class="section-title">{section.title}</h2>
          </div>
          <a href={sectionPath(section.slug)} class="more-link">All {section.title} →</a>
        </div>
        <div class={`grid items-start gap-8 max-[960px]:grid-cols-1 max-[960px]:gap-6 ${idx % 2 === 1 ? "grid-cols-[1fr_1.4fr]" : "grid-cols-[1.4fr_1fr]"}`}>
          <div>
            <ArticleCard article={lead} variant="default" />
          </div>
          <div class="flex flex-col gap-[18px] max-[960px]:grid max-[960px]:grid-cols-2 max-[560px]:grid-cols-1">
            {rest.map((a) => (
              <ArticleCard article={a} variant="compact" />
            ))}
          </div>
        </div>
        {idx === 1 && (
          <div class="mt-6 border-y border-border py-3">
            <AdSlot slot="native-in-feed" format="native-in-feed" label="Sponsored content" />
          </div>
        )}
      </section>
    );
  })}

  <!-- PREMIUM SECTION -->
  {premiums.length > 0 && (
    <section class="container-page mt-[72px] rounded-xl bg-ink p-10 text-white max-[960px]:p-6 max-[560px]:rounded-lg max-[560px]:p-5">
      <div class="section-head !border-b-[#2a2b33]">
        <div>
          <span class="eyebrow" style="color: var(--color-premium-gold)">PULSE+ Premium</span>
          <h2 class="section-title">Read deeper. Go further.</h2>
        </div>
        <a href="/subscription" class="more-link !text-premium-gold">Unlock all of PULSE+ →</a>
      </div>
      <p class="-mt-3 mb-7 max-w-[60ch] text-[15px] leading-relaxed text-[#b8bcc4]">
        Long-form reporting, exclusive investigations and the analysis our subscribers pay for.
        These are the stories that don't disappear in 24 hours.
      </p>
      <div class="grid grid-cols-3 gap-6 max-[960px]:grid-cols-2 max-[560px]:grid-cols-1">
        {premiums.map((a) => (
          <ArticleCard article={a} variant="premium" />
        ))}
      </div>
    </section>
  )}

  <!-- More featured -->
  {editorsPicks.length > 0 && (
    <section class="container-page mt-16">
      <div class="section-head">
        <div>
          <span class="eyebrow eyebrow-accent">Editor's picks</span>
          <h2 class="section-title">Worth your time</h2>
        </div>
      </div>
      <div class="grid grid-cols-4 gap-6 max-[960px]:grid-cols-2 max-[560px]:grid-cols-1">
        {editorsPicks.map((a) => (
          <ArticleCard article={a} variant="default" />
        ))}
      </div>
    </section>
  )}

  <ForYouRail client:visible />

  <section class="container-page mt-16">
    <Newsletter
      title="One more thing"
      subtitle="Weekend edition: one long read, delivered every Saturday morning. Free for subscribers."
      variant="inline"
    />
  </section>
</Layout>
