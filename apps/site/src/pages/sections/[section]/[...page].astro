---
import AdSlot from "../../../components/AdSlot.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import Newsletter from "../../../components/Newsletter.astro";
import Pagination from "../../../components/Pagination.astro";
import StructuredData from "../../../components/StructuredData.astro";
import Layout from "../../../layouts/Layout.astro";
import { PER_PAGE, paginate } from "../../../lib/format";
import { sectionPath } from "../../../lib/paths";
import { getEmdashClient } from "../../../lib/emdash/client";
import { getArticlesInSection, getSections } from "../../../lib/emdash/content";

const client = getEmdashClient(Astro.locals.runtime.env);
const sectionSlug = Astro.params.section;
const pageParam = Astro.params.page;
const requestedPage = pageParam ? Number(pageParam) : 1;
if (!sectionSlug || !Number.isInteger(requestedPage) || requestedPage < 1 || (pageParam && requestedPage === 1)) {
  // "/sections/x/1" isn't a canonical URL (page 1 lives at "/sections/x") — treat it as not found, same as any other bad param.
  return new Response(null, { status: 404 });
}

const sections = await getSections(client);
const section = sections.find((s) => s.slug === sectionSlug);
if (!section) {
  return new Response(null, { status: 404 });
}

const all = await getArticlesInSection(client, sectionSlug);
const { items, page, pages, total } = paginate(all, requestedPage, PER_PAGE);
if (requestedPage > pages) {
  return new Response(null, { status: 404 });
}

const highlight = all[0];
const restHighlights = all.slice(1, 3);
const listing = page === 1 ? all.slice(3) : items;

const siteOrigin = (Astro.site ?? Astro.url).origin;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteOrigin },
    {
      "@type": "ListItem",
      position: 2,
      name: section.title,
      item: new URL(sectionPath(section.slug), siteOrigin).toString(),
    },
  ],
};
---

<Layout
  title={`${section.title} — PULSE`}
  description={section.tagline}
  activeSection={section.slug}
  pageType="category"
  categories={[section.slug]}
>
  <StructuredData data={breadcrumbSchema} />

  <div class="container-page-wide flex justify-center pt-4 pb-2">
    <AdSlot slot="leaderboard-top" format="leaderboard" label="Advertisement" />
  </div>

  <section class="container-page pt-7 pb-2">
    <span class="eyebrow" style={`color:${section.accentColor}`}>Section</span>
    <h1 class="section-title mt-2">{section.title}</h1>
    <p class="mt-2.5 max-w-[50ch] text-[17px] text-ink-3">{section.tagline}</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {sections.map((s) => (
        <a
          href={sectionPath(s.slug)}
          class={`rounded-full border px-3.5 py-[7px] text-[13px] font-bold transition-all duration-200 ease-brand ${
            s.slug === section.slug
              ? "border-ink bg-ink text-white"
              : "border-border text-ink-2 hover:border-ink"
          }`}
        >{s.title}</a>
      ))}
    </div>
  </section>

  {page === 1 && highlight && (
    <section class="container-page">
      <div class="mt-8 grid grid-cols-[1.5fr_1fr] items-start gap-8 max-[960px]:grid-cols-1 max-[960px]:gap-6">
        <ArticleCard article={highlight} variant="hero" />
        <div class="flex flex-col gap-1">
          {restHighlights.map((a) => (
            <ArticleCard article={a} variant="list" />
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="container-page mt-12 grid grid-cols-[1fr_320px] items-start gap-10 max-[960px]:grid-cols-1 max-[960px]:gap-8">
    <div>
      <div class="section-head">
        <div>
          <span class="eyebrow eyebrow-accent">Latest in {section.title}</span>
          <h2 class="section-title">All stories</h2>
        </div>
        <span class="text-[13px] font-semibold whitespace-nowrap text-ink-4">{total} articles</span>
      </div>

      <div class="grid grid-cols-2 gap-6 max-sm:grid-cols-1">
        {listing.map((a, i) => (
          <>
            <ArticleCard article={a} variant="default" />
            {i === 2 && page === 1 && (
              <div class="col-span-full my-1 border-y border-border py-3">
                <AdSlot slot="native-in-feed" format="native-in-feed" label="Sponsored" />
              </div>
            )}
          </>
        ))}
      </div>

      <Pagination
        page={page}
        pages={pages}
        basePath={sectionPath(section.slug)}
      />
    </div>

    <aside class="sticky top-[calc(var(--spacing-header)+16px)] flex flex-col gap-6 max-[960px]:static">
      <AdSlot slot="mpu-rail" format="mpu" label="Advertisement" class="sticky top-20" />
      <div class="rounded-lg border border-border bg-bg-soft p-5">
        <h4 class="mb-3.5 border-b-2 border-ink pb-2.5 text-xs font-extrabold tracking-[0.12em] text-ink-3 uppercase">Most read in {section.title}</h4>
        <ol class="flex flex-col gap-3.5">
          {all.slice(0, 5).map((a, i) => (
            <li>
              <a href={`/articles/${a.slug}`} class="group grid grid-cols-[28px_1fr] items-start gap-3">
                <span class="font-display text-[22px] leading-none text-primary">{i + 1}</span>
                <span class="text-sm leading-[1.3] font-bold text-ink group-hover:text-primary">{a.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <Newsletter
          title={`Never miss a ${section.title} story`}
          subtitle={`Get the best of ${section.title} in your inbox.`}
          variant="compact"
        />
      </div>
    </aside>
  </div>
</Layout>
