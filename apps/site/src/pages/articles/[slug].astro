---
import AdSlot from "../../components/AdSlot.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import CommentForm from "../../components/CommentForm.tsx";
import CommentsList from "../../components/CommentsList.tsx";
import Newsletter from "../../components/Newsletter.astro";
import Lightbox from "../../components/Lightbox.astro";
import PortableText from "../../components/portable-text/PortableText.astro";
import { snapToListBoundary } from "../../components/portable-text/types";
import ReadingControls from "../../components/ReadingControls.astro";
import ReadingHistoryTracker from "../../components/ReadingHistoryTracker.astro";
import RelatedRail from "../../components/RelatedRail.astro";
import SaveButton from "../../components/SaveButton.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import StructuredData from "../../components/StructuredData.astro";
import TrendingList from "../../components/TrendingList.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../lib/format";
import { articlePath, authorPath, sectionPath, tagPath } from "../../lib/paths";
import { getEmdashClient } from "../../lib/emdash/client";
import { urlFor } from "../../lib/emdash/image";
import {
  getArticleBySlug,
  getArticlesInSection,
  getPremiumArticles,
  getSiteSettings,
  getTrendingArticles,
} from "../../lib/emdash/content";
import MosShow from "../../components/MosShow.astro";
import { FAKE_COMMENTS } from "../../lib/fake-comments";

const { slug } = Astro.params;
const client = getEmdashClient(Astro.locals.runtime.env);
const article = slug ? await getArticleBySlug(client, slug) : null;
if (!article) {
  return new Response(null, { status: 404 });
}

const section = article.section;
const articleAuthors = article.authors ?? [];
const isPremium = article.premium ?? false;
// Streaming-safe way to hand extra Cache-Tag values up to middleware.ts,
// which merges these with the path-derived `article:<slug>` tag and sets
// the final header — see docs/mos-integration-plan.md Session 3.
Astro.response.headers.set(
  "Cache-Tag",
  [`section:${section.slug}`, ...articleAuthors.map((a) => `author:${a.slug}`)].join(",")
);
const [sameSectionAll, settings, trending, premiumAll] = await Promise.all([
  getArticlesInSection(client, section.slug),
  getSiteSettings(client),
  getTrendingArticles(client),
  isPremium ? getPremiumArticles(client) : Promise.resolve([]),
]);
const sameSection = sameSectionAll.filter((a) => a.slug !== article.slug).slice(0, 4);
const morePremium = premiumAll.filter((a) => a.slug !== article.slug).slice(0, 4);

const blocks = article.body;
// Paywall cut: how many blocks are free to read. Snapped forward past any
// list run it would otherwise split in two.
const freePreviewCount = snapToListBoundary(
  blocks,
  Math.min(Math.max(article.freePreviewBlocks ?? 3, 0), blocks.length)
);
// Ad cut: unrelated to the paywall, kept at the article midpoint as before.
const adSplitIdx = Math.floor(blocks.length / 2);
// The two cuts are independent, so the ad usually lands inside the locked
// segment and disappears for gated readers along with the rest of it. This
// is intentional — see docs/mos-selectors.md ("paywall-slot") for why the
// wall creative carries its own ad unit to cover that case, rather than
// moving this ad and degrading the layout for ungated readers.
const adInPreview = adSplitIdx <= freePreviewCount;

const siteOrigin = (Astro.site ?? Astro.url).origin;
const articleUrl = new URL(articlePath(article.slug), Astro.url).toString();
const heroImageUrl = urlFor(article.hero).width(1600).height(900).fit("crop").url();
const ogImageUrl = article.seo?.ogImage
  ? urlFor(article.seo.ogImage).width(1200).height(630).fit("crop").url()
  : urlFor(article.hero).width(1200).height(630).fit("crop").url();

const newsArticleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: article.title,
  description: article.dek,
  image: [heroImageUrl],
  datePublished: article.publishedAt,
  dateModified: article.publishedAt,
  mainEntityOfPage: { "@type": "WebPage", "@id": articleUrl },
  articleSection: section.title,
  author: articleAuthors.map((a) => ({
    "@type": "Person",
    name: a.name,
    url: new URL(authorPath(a.slug), siteOrigin).toString(),
  })),
  publisher: {
    "@type": "Organization",
    name: settings.title,
    logo: { "@type": "ImageObject", url: new URL("/favicon.svg", siteOrigin).toString() },
  },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteOrigin },
    {
      "@type": "ListItem",
      position: 2,
      name: section.title,
      item: new URL(sectionPath(section.slug), siteOrigin).toString(),
    },
    { "@type": "ListItem", position: 3, name: article.title, item: articleUrl },
  ],
};
---

<Layout
  title={article.seo?.metaTitle || `${article.title} — PULSE`}
  description={article.seo?.metaDescription || article.dek}
  activeSection={section.slug}
  ogImageUrl={ogImageUrl}
  pageType="article"
  articleType={isPremium ? "premium" : "standard"}
  tags={article.tags ?? undefined}
  categories={[section.slug]}
  authors={articleAuthors.map((a) => a.slug)}
>
  <StructuredData data={[newsArticleSchema, breadcrumbSchema]} />

  <div class="container-page-wide">
    <AdSlot slot="leaderboard-top" format="leaderboard" label="Advertisement" />
  </div>

  <article>
    <!-- Premium banner -->
    {isPremium && (
      <div class="bg-premium-gold text-[#2a1d00]" data-mos="premium-banner">
        <div class="container-page flex flex-wrap items-center justify-center gap-4 py-3">
          <span class="inline-flex items-center gap-1.5 rounded-sm bg-[#2a1d00] px-2.5 py-[5px] text-xs font-extrabold tracking-[0.08em] text-premium-gold uppercase">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 6.5L21 9.2l-5 4.3 1.6 6.8L12 16.9 6.4 20.3 8 13.5 3 9.2l6.6-.7L12 2z"/></svg>
            PULSE+ Premium
          </span>
          <span class="min-w-[200px] text-sm font-semibold inline-flex">
            <MosShow when="no-premium">
              This is in-depth reporting for subscribers.
              Unlock the full archive with PULSE+.
            </MosShow>
            <MosShow when="premium-only">
              This is an exclusive article for you as a PULSE+ subscriber.
            </MosShow>
          </span>
          <MosShow when="no-premium">
            <a href="/subscription" class="rounded-full bg-[#2a1d00] px-4 py-2 text-[13px] font-extrabold text-premium-gold">Subscribe</a>
          </MosShow>
        </div>
      </div>
    )}

    <!-- Header -->
    <header class="container-page max-w-[760px] pt-7">
      <a href={sectionPath(section.slug)} class="text-xs font-extrabold tracking-[0.1em] text-[var(--sec,var(--color-primary))] uppercase" style={`--sec:${section.accentColor}`}>
        {section.title}
      </a>
      <h1 class="mt-2.5 text-[clamp(30px,5vw,52px)] leading-[1.05] tracking-[-0.02em]">{article.title}</h1>
      <p class="mt-4 text-[clamp(17px,2vw,21px)] leading-relaxed text-ink-3">{article.dek}</p>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-5">
        <div class="flex flex-wrap gap-4">
          {articleAuthors.map((a) => (
            <a href={authorPath(a.slug)} class="byline">
              <img src={urlFor(a.avatar).width(64).height(64).fit("crop").url()} alt="" class="avatar size-8" width="32" height="32" loading="lazy" />
              <span class="name">{a.name}</span>
            </a>
          ))}
        </div>
        <div class="meta-row">
          <span>{formatDate(article.publishedAt)}</span>
          <span class="dot"></span>
          <span>{article.readTime} min read</span>
        </div>
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <ShareButtons url={articleUrl} title={article.title} />
        <div class="flex items-center gap-3">
          <SaveButton slug={article.slug} variant="full" />
        </div>
      </div>
    </header>

    <!-- Hero media -->
    <figure class="container-page-wide mt-7">
      <img src={heroImageUrl} alt={article.hero.alt ?? ""} width="1600" height="900" fetchpriority="high" class="aspect-video w-full rounded-lg bg-bg-muted object-cover max-sm:rounded" />
      <figcaption class="mx-auto mt-2.5 max-w-(--container-content) text-xs text-ink-4">{article.hero.alt}</figcaption>
    </figure>

    <!-- Body + sidebar -->
    <div class="container-page mt-10 grid grid-cols-[1fr_320px] items-start gap-12 max-[960px]:grid-cols-1 max-[960px]:gap-8">
      <div class="w-full max-w-[680px]">
        <div data-mos="article-body">
          <AdSlot slot="in-article-1" format="in-article" label="Advertisement" class="my-[2em]" />

          <div data-mos="article-preview">
            <PortableText
              value={adInPreview ? blocks.slice(0, adSplitIdx) : blocks.slice(0, freePreviewCount)}
              startIndex={0}
            />
            {adInPreview && <AdSlot slot="in-article-2" format="in-article" label="Advertisement" class="my-[2em]" />}
            {adInPreview && (
              <PortableText value={blocks.slice(adSplitIdx, freePreviewCount)} startIndex={adSplitIdx} />
            )}
          </div>

          <div data-mos="article-locked">
            <PortableText
              value={adInPreview ? blocks.slice(freePreviewCount) : blocks.slice(freePreviewCount, adSplitIdx)}
              startIndex={freePreviewCount}
            />
            {!adInPreview && <AdSlot slot="in-article-2" format="in-article" label="Advertisement" class="my-[2em]" />}
            {!adInPreview && <PortableText value={blocks.slice(adSplitIdx)} startIndex={adSplitIdx} />}
          </div>

          <div data-mos="paywall-slot"></div>
        </div>

        <!-- Tags -->
        {article.tags && article.tags.length > 0 && (
          <div class="mt-10 border-t border-border pt-6">
            <span class="mb-3 block text-[11px] font-extrabold tracking-[0.12em] text-ink-4 uppercase">Tags</span>
            <div class="flex flex-wrap gap-2">
              {article.tags.map((t) => (
                <a href={tagPath(t)} class="rounded-full border border-border px-[13px] py-[7px] text-sm font-semibold text-ink-2 transition-all duration-200 ease-brand hover:border-primary hover:text-primary">{t}</a>
              ))}
            </div>
          </div>
        )}

        <!-- Authors footer -->
        <div class="mt-10 flex flex-col gap-6 border-t border-border pt-8">
          {articleAuthors.map((a) => (
            <div class="grid grid-cols-[64px_1fr] items-start gap-4">
              <img src={urlFor(a.avatar).width(128).height(128).fit("crop").url()} alt={a.name} class="size-16 rounded-full object-cover" width="64" height="64" loading="lazy" />
              <div>
                <a href={authorPath(a.slug)} class="block text-base font-extrabold text-ink hover:text-primary">{a.name}</a>
                <span class="mb-1.5 block text-xs text-ink-4">{a.role}</span>
                <p class="text-sm leading-[1.55] text-ink-3">{a.bio}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Comments placeholder -->
        <section class="mt-12 flex flex-col gap-8" data-mos="comments">
          <div>
            <h3 class="text-xl">
              {FAKE_COMMENTS.length} responses to "{article.title}"
            </h3>
            <p class="mt-1.5 text-sm text-ink-3">Join the conversation. Be kind, be specific, be brave.</p>
          </div>

          <div class="border-b border-border pb-8">
            <MosShow when="signed-out">
              <div class="flex flex-col items-center gap-3 rounded-lg border border-border bg-surface-2 px-6 py-6 text-center">
                <p class="text-sm text-ink-3">Sign in to join the conversation and leave a comment.</p>
                <a
                  href="/sign-in"
                  data-mos-action="sign-in"
                  class="rounded-full bg-ink px-5 py-2.5 text-[13px] font-bold text-white transition-colors duration-200 hover:bg-primary"
                >
                  Sign in
                </a>
              </div>
            </MosShow>
            <MosShow when="signed-in">
              <CommentForm client:idle />
            </MosShow>
          </div>

          <CommentsList client:idle />
        </section>
      </div>

      <aside class="sticky top-[calc(var(--spacing-header)+16px)] flex flex-col gap-6 self-start max-[960px]:static">
        <AdSlot slot="mpu-rail" format="mpu" label="Advertisement" class="mb-1" />
        <div class="sticky top-[calc(var(--spacing-header)+280px)] flex flex-col gap-6 max-[960px]:static">
          <RelatedRail article={article} title="Related stories" limit={4} />
          <TrendingList articles={trending} limit={4} />
          <Newsletter
            title="The morning PULSE"
            subtitle="One email. Every weekday. Free."
            variant="compact"
          />

          <!--
            Ad-free readers who aren't premium yet: paid tiers are Ad-Free <
            Premium (Premium includes everything Ad-Free has), so
            has-subscription + no-premium == "ad-free, not premium". Styled
            like the dashed AdSlot placeholders to sit naturally in the ad
            rhythm, but deliberately NOT an AdSlot/[data-ad-slot] — that gets
            stripped for ad-free readers, who are exactly this banner's
            audience.
          -->
          <MosShow when="has-subscription">
            <MosShow when="no-premium">
              <div
                class="flex flex-col items-center gap-2.5 rounded-lg border border-dashed border-border-strong bg-bg-soft p-5 text-center"
                data-mos="ad-free-premium-upsell"
              >
                <span class="inline-flex items-center gap-1.5 rounded-sm bg-premium-gold px-2.5 py-[5px] text-xs font-extrabold tracking-[0.08em] text-[#2a1d00] uppercase">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 6.5L21 9.2l-5 4.3 1.6 6.8L12 16.9 6.4 20.3 8 13.5 3 9.2l6.6-.7L12 2z"/></svg>
                  PULSE+ Premium
                </span>
                <p class="text-sm font-bold text-ink">You're already ad-free. Go further with PULSE+.</p>
                <p class="text-[13px] leading-snug text-ink-3">Unlimited premium reporting, exclusive investigations and analysis.</p>
                <a
                  href="/subscription"
                  class="mt-1.5 rounded-full bg-premium-gold px-4 py-2 text-[13px] font-extrabold text-[#2a1d00] transition-all duration-200 ease-brand hover:-translate-y-px hover:brightness-105"
                >
                  Upgrade to PULSE+
                </a>
              </div>
            </MosShow>
          </MosShow>
        </div>
      </aside>
    </div>

    <!-- More premium -->
    {isPremium && morePremium.length > 0 && (
      <section class="container-page mt-[72px] rounded-xl bg-ink p-10 text-white max-[960px]:p-6 max-sm:rounded-lg max-sm:p-5" data-mos="more-premium">
        <div class="section-head !border-b-[#2a2b33]">
          <div>
            <span class="eyebrow inline-flex items-center gap-1.5" style="color: var(--color-premium-gold)">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 6.5L21 9.2l-5 4.3 1.6 6.8L12 16.9 6.4 20.3 8 13.5 3 9.2l6.6-.7L12 2z"/></svg>
              More from PULSE+ Premium
            </span>
            <h2 class="section-title">Keep reading with PULSE+</h2>
          </div>
          <MosShow when="no-premium">
            <a href="/subscription" class="more-link !text-premium-gold">Unlock all of PULSE+ →</a>
          </MosShow>
        </div>
        <div class="grid grid-cols-4 gap-6 max-[960px]:grid-cols-2 max-sm:grid-cols-1">
          {morePremium.map((a) => (
            <ArticleCard article={a} variant="premium" />
          ))}
        </div>
      </section>
    )}

    <!-- Footer related -->
    <section class="container-page mt-16" data-mos="related">
      <div class="section-head">
        <div>
          <span class="eyebrow eyebrow-accent">Keep reading</span>
          <h2 class="section-title">More from {section.title}</h2>
        </div>
        <a href={sectionPath(section.slug)} class="more-link">All {section.title} →</a>
      </div>
      <div class="grid grid-cols-4 gap-6 max-[960px]:grid-cols-2 max-sm:grid-cols-1">
        {sameSection.map((a) => (
          <ArticleCard article={a} variant="default" />
        ))}
      </div>
    </section>

    <section class="container-page mt-16">
      <Newsletter
        title="One more thing"
        subtitle="Weekend edition: one long read, every Saturday. Free."
        variant="inline"
      />
    </section>
  </article>

  <Lightbox />
  <ReadingHistoryTracker section={section.slug} tags={article.tags ?? []} />
</Layout>
