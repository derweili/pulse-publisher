---
import AdSlot from "../../components/AdSlot.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Newsletter from "../../components/Newsletter.astro";
import Pagination from "../../components/Pagination.astro";
import Layout from "../../layouts/Layout.astro";
import { PER_PAGE } from "../../lib/format";
import { authorPath } from "../../lib/paths";
import { getSanityClient } from "../../lib/sanity/client";
import { urlFor } from "../../lib/sanity/image";
import { getArticlesByAuthor, getAuthors } from "../../lib/sanity/fetch";

const authorSlug = Astro.params.author;
const client = getSanityClient(Astro.locals.runtime.env);
const authors = await getAuthors(client);
const author = authorSlug ? authors.find((a) => a.slug === authorSlug) : undefined;
if (!author) {
  return new Response(null, { status: 404 });
}

const all = await getArticlesByAuthor(client, authorSlug!);
const pages = Math.max(1, Math.ceil(all.length / PER_PAGE));
const total = all.length;
const top = all[0];
const rest = all.slice(1);
---

<Layout
  title={author.seo?.metaTitle || `${author.name} — PULSE`}
  description={author.seo?.metaDescription || author.bio}
  ogImageUrl={urlFor(author.avatar).width(1200).height(630).fit("crop").url()}
  pageType="author"
  authors={[author.slug]}
>
  <div class="container-page-wide">
    <AdSlot slot="leaderboard-top" format="leaderboard" label="Advertisement" />
  </div>

  <section class="container-page pt-8">
    <div class="grid grid-cols-[120px_1fr] items-center gap-7 rounded-xl border border-border bg-bg-soft p-8 max-sm:grid-cols-1 max-sm:justify-items-center max-sm:p-6 max-sm:text-center">
      <img src={urlFor(author.avatar).width(240).height(240).fit("crop").url()} alt={author.name} class="size-[120px] rounded-full border-[3px] border-white object-cover shadow max-sm:mx-auto" width="120" height="120" />
      <div>
        <span class="eyebrow eyebrow-accent">{author.role}</span>
        <h1 class="mt-2 font-display text-[clamp(28px,4vw,44px)] leading-none tracking-[0.01em]">{author.name}</h1>
        <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-ink-3 max-sm:mx-auto">{author.bio}</p>
        <div class="mt-4 flex gap-[18px] text-[13px] text-ink-4 max-sm:justify-center">
          <span><strong class="text-ink">{all.length}</strong> articles</span>
          {author.twitter && (
            <a href={`https://twitter.com/${author.twitter}`} class="font-bold text-primary" target="_blank" rel="noopener noreferrer">
              @{author.twitter}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {top && (
    <section class="container-page mt-16">
      <div class="section-head">
        <div>
          <span class="eyebrow eyebrow-accent">Top story</span>
          <h2 class="section-title">Featured</h2>
        </div>
      </div>
      <ArticleCard article={top} variant="hero" />
    </section>
  )}

  <div class="container-page mt-12 grid grid-cols-[1fr_320px] items-start gap-10 max-[960px]:grid-cols-1 max-[960px]:gap-8">
    <div>
      <div class="section-head">
        <div>
          <span class="eyebrow eyebrow-accent">More from {author.name}</span>
          <h2 class="section-title">All articles</h2>
        </div>
        <span class="text-[13px] font-semibold whitespace-nowrap text-ink-4">{total} articles</span>
      </div>

      <div class="grid grid-cols-2 gap-6 max-sm:grid-cols-1">
        {rest.map((a, i) => (
          <>
            <ArticleCard article={a} variant="default" />
            {i === 1 && (
              <div class="col-span-full my-1 border-y border-border py-3">
                <AdSlot slot="native-in-feed" format="native-in-feed" label="Sponsored" />
              </div>
            )}
          </>
        ))}
      </div>

      {pages > 1 && (
        <Pagination page={1} pages={pages} basePath={authorPath(author.slug)} />
      )}
    </div>

    <aside class="sticky top-[calc(var(--spacing-header)+16px)] flex flex-col gap-6 max-[960px]:static">
      <AdSlot slot="mpu-rail" format="mpu" label="Advertisement" />
      <div class="rounded-lg border border-border bg-bg-soft p-5">
        <h4 class="mb-3.5 border-b-2 border-ink pb-2.5 text-xs font-extrabold tracking-[0.12em] text-ink-3 uppercase">More voices</h4>
        <ul class="flex flex-col gap-3.5">
          {authors.filter((a) => a.slug !== author.slug).slice(0, 4).map((a) => (
            <li>
              <a href={authorPath(a.slug)} class="group flex items-center gap-3">
                <img src={urlFor(a.avatar).width(88).height(88).fit("crop").url()} alt="" class="size-11 rounded-full object-cover" width="44" height="44" loading="lazy" />
                <div>
                  <span class="block text-sm font-bold text-ink group-hover:text-primary">{a.name}</span>
                  <span class="block text-[11px] text-ink-4">{a.role}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <Newsletter
        title={`Follow ${author.name}`}
        subtitle={`Get their next story in your inbox.`}
        variant="compact"
      />
    </aside>
  </div>
</Layout>
