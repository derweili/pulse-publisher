---
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;

const links = [
  {
    label: "Share on X",
    href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`,
    icon: "M18.9 2h3.1l-6.8 7.8L23 22h-6.3l-4.9-6.4L6.2 22H3l7.3-8.4L2.7 2H9l4.4 5.9L18.9 2zm-1.1 18h1.7L7.3 3.9H5.5L17.8 20z",
  },
  {
    label: "Share on Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
    icon: "M13.5 21v-7.6h2.6l.4-3H13.5V8.4c0-.9.2-1.5 1.5-1.5h1.6V4.2C16.3 4.1 15.3 4 14.2 4c-2.4 0-4 1.5-4 4.1v2.3H7.6v3h2.6V21h3.3z",
  },
  {
    label: "Share on LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
    icon: "M6.9 8.4H3.6V20H6.9V8.4zM5.3 3.4a1.9 1.9 0 100 3.9 1.9 1.9 0 000-3.9zM20.4 20h-3.3v-5.9c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V20H9.6V8.4h3.2v1.6h.1c.4-.8 1.5-1.7 3.2-1.7 3.4 0 4.1 2.3 4.1 5.2V20z",
  },
  {
    label: "Share by email",
    href: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`,
    icon: "M4 5h16a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1zm0 2.2V18h16V7.2l-8 5.4-8-5.4zm.7-.2L12 12l7.3-5H4.7z",
  },
];
---

<div class="flex items-center gap-2" data-share-buttons>
  <span class="mr-1 text-xs font-bold tracking-[0.1em] text-ink-4 uppercase">Share</span>
  {links.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={link.label}
      class="grid size-9 shrink-0 place-items-center rounded-full border border-border text-ink-3 transition-colors duration-200 ease-brand hover:border-ink hover:text-ink"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d={link.icon} /></svg>
    </a>
  ))}
  <button
    type="button"
    aria-label="Copy link"
    class="relative grid size-9 shrink-0 place-items-center rounded-full border border-border text-ink-3 transition-colors duration-200 ease-brand hover:border-ink hover:text-ink"
    data-copy-link
    data-url={url}
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-copy-icon>
      <path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11.5 4.5" />
      <path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L12.5 19.5" />
    </svg>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="hidden text-success" data-copy-check>
      <path d="M20 6 9 17l-5-5" />
    </svg>
    <span class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 rounded-md bg-ink px-2 py-1 text-[11px] font-semibold whitespace-nowrap text-white opacity-0 transition-opacity duration-200" data-copy-tooltip>
      Link copied
    </span>
  </button>
</div>

<script>
  function initShareButtons(root: HTMLElement) {
    const btn = root.querySelector<HTMLButtonElement>("[data-copy-link]");
    if (!btn) return;
    const icon = btn.querySelector<SVGElement>("[data-copy-icon]");
    const check = btn.querySelector<SVGElement>("[data-copy-check]");
    const tooltip = btn.querySelector<HTMLElement>("[data-copy-tooltip]");
    btn.addEventListener("click", async () => {
      const url = btn.dataset.url ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        return;
      }
      icon?.classList.add("hidden");
      check?.classList.remove("hidden");
      tooltip?.classList.add("opacity-100");
      setTimeout(() => {
        icon?.classList.remove("hidden");
        check?.classList.add("hidden");
        tooltip?.classList.remove("opacity-100");
      }, 1800);
    });
  }
  document.querySelectorAll<HTMLElement>("[data-share-buttons]").forEach(initShareButtons);
</script>
