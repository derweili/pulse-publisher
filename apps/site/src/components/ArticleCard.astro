---
import { formatDate } from "../lib/format";
import { articlePath, authorPath, sectionPath } from "../lib/paths";
import { imageUrl } from "../lib/payload/image";
import type { ArticleCardData } from "../lib/payload/fetch";
import SaveButton from "./SaveButton.astro";

interface Props {
  article: ArticleCardData;
  variant?: "default" | "hero" | "compact" | "list" | "premium" | "feed";
  showSection?: boolean;
  showDek?: boolean;
}

const {
  article,
  variant = "default",
  showSection = true,
  showDek = true,
} = Astro.props;

const section = article.section;
const primaryAuthor = article.authors?.[0];
const isPremium = article.premium ?? false;
---

{variant === "hero" && (
  <article class="flex flex-col" data-mos="article-card" data-premium={isPremium ? "true" : "false"}>
    <a href={articlePath(article.slug)} class="group relative block aspect-video overflow-hidden rounded-lg bg-bg-muted">
      <img src={imageUrl(article.hero, "cardWide")} alt={article.hero.alt ?? ""} loading="eager" width="1200" height="750" class="h-full w-full object-cover transition-transform duration-[600ms] ease-brand group-hover:scale-[1.04]" />
      <span class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0)_40%,rgba(0,0,0,0.5))]"></span>
      {showSection && section && (
        <span class="absolute top-4 left-4 rounded-sm bg-primary px-3 py-1.5 text-[11px] font-extrabold tracking-[0.1em] text-white uppercase">{section.title}</span>
      )}
      {isPremium && (
        <span class="absolute top-4 right-4 inline-flex items-center gap-1.5 rounded-sm bg-premium-gold px-3 py-1.5 text-[11px] font-extrabold tracking-[0.1em] text-[#2a1d00] uppercase" data-mos="premium-badge">Premium</span>
      )}
    </a>
    <div class="px-1 pt-5">
      <h2 class="text-[clamp(24px,3vw,36px)] leading-[1.1] tracking-[-0.02em]">
        <a
          href={articlePath(article.slug)}
          class={`hover:text-primary ${isPremium ? "bg-[linear-gradient(90deg,var(--color-ink),var(--color-ink-2))] bg-clip-text" : ""}`}
        >{article.title}</a>
      </h2>
      {showDek && <p class="mt-3 max-w-[60ch] text-base leading-normal text-ink-3 max-sm:text-[15px]">{article.dek}</p>}
      <div class="mt-1 flex flex-wrap items-center justify-between gap-2">
        <div class="inline-flex flex-wrap items-center gap-2 text-xs font-medium text-ink-4">
          {primaryAuthor && (
            <a href={authorPath(primaryAuthor.slug)} class="inline-flex items-center gap-2">
              <img src={imageUrl(primaryAuthor.avatar, "avatarSm")} alt="" class="size-7 rounded-full bg-bg-muted object-cover" width="28" height="28" loading="lazy" />
              <span class="text-[13px] font-bold text-ink-2 hover:text-primary">{primaryAuthor.name}</span>
            </a>
          )}
          <span class="dot"></span>
          <span>{formatDate(article.publishedAt)}</span>
          <span class="dot"></span>
          <span>{article.readTime} min</span>
        </div>
        <SaveButton slug={article.slug} />
      </div>
    </div>
  </article>
)}

{variant === "default" && (
  <article class="group flex flex-col overflow-hidden rounded-lg border border-border bg-surface transition-all duration-200 ease-brand hover:-translate-y-1 hover:border-border-strong hover:shadow-lg" data-mos="article-card" data-premium={isPremium ? "true" : "false"}>
    <a href={articlePath(article.slug)} class="relative block aspect-[16/10] overflow-hidden bg-bg-muted">
      <img src={imageUrl(article.hero, "card")} alt={article.hero.alt ?? ""} loading="lazy" width="800" height="500" class="h-full w-full object-cover transition-transform duration-[600ms] ease-brand group-hover:scale-105" />
      {isPremium && (
        <span class="absolute top-3 right-3 rounded-[5px] bg-premium-gold px-[9px] py-[5px] text-[10px] font-extrabold tracking-[0.08em] text-[#2a1d00] uppercase" data-mos="premium-badge">Premium</span>
      )}
    </a>
    <div class="flex flex-1 flex-col gap-2.5 px-5 pt-[18px] pb-5">
      {showSection && section && (
        <a href={sectionPath(section.slug)} class="w-fit text-[11px] font-extrabold tracking-[0.1em] text-[var(--sec,var(--color-primary))] uppercase hover:underline" style={`--sec:${section.accentColor}`}>
          {section.title}
        </a>
      )}
      <h3 class="text-[19px] leading-[1.2] tracking-[-0.01em]">
        <a href={articlePath(article.slug)} class="hover:text-primary">{article.title}</a>
      </h3>
      {showDek && <p class="text-sm leading-relaxed text-ink-3">{article.dek}</p>}
      <div class="mt-auto flex flex-wrap items-center justify-between gap-2">
        <div class="inline-flex flex-wrap items-center gap-2 text-xs font-medium text-ink-4">
          {primaryAuthor && <span class="font-bold text-ink-2 hover:text-primary">{primaryAuthor.name}</span>}
          <span class="dot"></span>
          <span>{article.readTime} min</span>
        </div>
        <SaveButton slug={article.slug} />
      </div>
    </div>
  </article>
)}

{variant === "compact" && (
  <article class="group grid grid-cols-[96px_1fr] items-start gap-3.5 max-sm:grid-cols-[80px_1fr] max-sm:gap-3" data-mos="article-card" data-premium={isPremium ? "true" : "false"}>
    <a href={articlePath(article.slug)} class="relative block aspect-square overflow-hidden rounded bg-bg-muted">
      <img src={imageUrl(article.hero, "thumbSquare")} alt={article.hero.alt ?? ""} loading="lazy" width="200" height="200" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      {isPremium && (
        <span class="absolute top-3 right-3 rounded-[5px] bg-premium-gold px-2 py-1 text-[9px] font-extrabold tracking-[0.08em] text-[#2a1d00] uppercase" data-mos="premium-badge">Premium</span>
      )}
    </a>
    <div class="flex min-w-0 flex-col gap-1.5">
      {showSection && section && (
        <a href={sectionPath(section.slug)} class="w-fit text-[10px] font-extrabold tracking-[0.1em] text-[var(--sec,var(--color-primary))] uppercase hover:underline" style={`--sec:${section.accentColor}`}>
          {section.title}
        </a>
      )}
      <h4 class="text-[15px] leading-[1.25]">
        <a href={articlePath(article.slug)} class="hover:text-primary">{article.title}</a>
      </h4>
      <div class="inline-flex flex-wrap items-center gap-1.5 text-[11px] font-medium text-ink-4">
        <span>{article.readTime} min</span>
      </div>
    </div>
  </article>
)}

{variant === "list" && (
  <article class="group grid grid-cols-[200px_1fr] gap-5 border-b border-border py-4 max-sm:grid-cols-[120px_1fr] max-sm:gap-3.5" data-mos="article-card" data-premium={isPremium ? "true" : "false"}>
    <a href={articlePath(article.slug)} class="relative block aspect-[3/2] overflow-hidden rounded bg-bg-muted">
      <img src={imageUrl(article.hero, "thumbList")} alt={article.hero.alt ?? ""} loading="lazy" width="240" height="160" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" />
      {isPremium && (
        <span class="absolute top-3 right-3 rounded-[5px] bg-premium-gold px-2 py-1 text-[9px] font-extrabold tracking-[0.08em] text-[#2a1d00] uppercase" data-mos="premium-badge">Premium</span>
      )}
    </a>
    <div class="flex min-w-0 flex-col gap-2">
      {showSection && section && (
        <a href={sectionPath(section.slug)} class="w-fit text-[10px] font-extrabold tracking-[0.1em] text-[var(--sec,var(--color-primary))] uppercase hover:underline" style={`--sec:${section.accentColor}`}>
          {section.title}
        </a>
      )}
      <h3 class="text-xl leading-[1.2] max-sm:text-[17px]">
        <a href={articlePath(article.slug)} class="hover:text-primary">{article.title}</a>
      </h3>
      {showDek && <p class="text-sm leading-relaxed text-ink-3">{article.dek}</p>}
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="inline-flex flex-wrap items-center gap-2 text-xs font-medium text-ink-4">
          {primaryAuthor && <span class="font-bold text-ink-2 hover:text-primary">{primaryAuthor.name}</span>}
          <span class="dot"></span>
          <span>{formatDate(article.publishedAt)}</span>
          <span class="dot"></span>
          <span>{article.readTime} min</span>
        </div>
        <SaveButton slug={article.slug} />
      </div>
    </div>
  </article>
)}

{variant === "feed" && (
  <article class="flex flex-col gap-2 border-b border-border py-4" data-mos="article-card" data-premium={isPremium ? "true" : "false"}>
    {showSection && section && (
      <a href={sectionPath(section.slug)} class="w-fit text-[10px] font-extrabold tracking-[0.1em] text-[var(--sec,var(--color-primary))] uppercase hover:underline" style={`--sec:${section.accentColor}`}>
        {section.title}
      </a>
    )}
    <h3 class="text-[17px] leading-[1.25]">
      <a href={articlePath(article.slug)} class="hover:text-primary">{article.title}</a>
    </h3>
    <div class="mt-auto inline-flex flex-wrap items-center gap-2 text-xs font-medium text-ink-4">
      {primaryAuthor && <span class="font-bold text-ink-2 hover:text-primary">{primaryAuthor.name}</span>}
      <span class="dot"></span>
      <span>{article.readTime} min</span>
    </div>
  </article>
)}

{variant === "premium" && (
  <a href={articlePath(article.slug)} class="group relative flex flex-col overflow-hidden rounded-lg border border-[#22232a] bg-premium text-white transition-all duration-200 ease-brand hover:-translate-y-1 hover:shadow-xl" data-mos="article-card" data-premium={isPremium ? "true" : "false"}>
    <div class="relative aspect-[16/10] overflow-hidden bg-[#15161a]">
      <img src={imageUrl(article.hero, "card")} alt={article.hero.alt ?? ""} loading="lazy" width="800" height="500" class="h-full w-full object-cover opacity-[0.92] transition-transform duration-[600ms] group-hover:scale-[1.04]" />
      <span class="absolute top-3.5 left-3.5 inline-flex items-center gap-1.5 rounded-sm bg-premium-gold px-[11px] py-1.5 text-[11px] font-extrabold tracking-[0.1em] text-[#2a1d00] uppercase" data-mos="premium-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 6.5L21 9.2l-5 4.3 1.6 6.8L12 16.9 6.4 20.3 8 13.5 3 9.2l6.6-.7L12 2z"/></svg>
        Premium
      </span>
    </div>
    <div class="flex flex-col gap-3 px-[22px] pt-[22px] pb-6">
      {showSection && section && (
        <span class="text-[11px] font-extrabold tracking-[0.12em] text-premium-gold uppercase">{section.title}</span>
      )}
      <h3 class="text-[22px] leading-[1.2] text-white">{article.title}</h3>
      {showDek && <p class="text-sm leading-[1.55] text-[#b8bcc4]">{article.dek}</p>}
      <div class="inline-flex items-center gap-2 text-xs text-[#8a8f99]">
        {primaryAuthor && <span>{primaryAuthor.name}</span>}
        <span class="dot"></span>
        <span>{article.readTime} min read</span>
      </div>
      <span class="mt-1 inline-flex w-fit items-center gap-1.5 rounded-full bg-premium-gold px-3.5 py-2.5 text-xs font-extrabold tracking-[0.04em] text-[#2a1d00] uppercase">Read with PULSE+</span>
    </div>
  </a>
)}
