---
import { articlePath } from "../lib/paths";
import { getSanityClient } from "../lib/sanity/client";
import { urlFor } from "../lib/sanity/image";
import { getRelatedArticles, type ArticleDetail } from "../lib/sanity/fetch";

interface Props {
  article: Pick<ArticleDetail, "slug" | "section" | "tags">;
  title?: string;
  limit?: number;
}
const { article, title = "More from this section", limit = 4 } = Astro.props;
const client = getSanityClient(Astro.locals.runtime.env);
const related = await getRelatedArticles(client, article, limit);
---

{related.length > 0 && (
  <aside class="flex flex-col gap-3" data-mos="related">
    <h4 class="border-b-2 border-ink pb-2.5 text-xs font-extrabold tracking-[0.12em] text-ink-3 uppercase">{title}</h4>
    <ul class="flex flex-col gap-3.5">
      {related.map((r) => {
        const a = r.authors?.[0];
        return (
          <li>
            <a href={articlePath(r.slug)} class="group grid grid-cols-[84px_1fr] items-start gap-3">
              <div class="relative aspect-[4/3] overflow-hidden rounded-[8px] bg-bg-muted">
                <img src={urlFor(r.hero).width(120).height(90).fit("crop").url()} alt={r.hero.alt ?? ""} loading="lazy" width="120" height="80" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.06]" />
                {r.premium && (
                  <span class="absolute top-1.5 right-1.5 inline-flex size-4 items-center justify-center rounded-[4px] bg-premium-gold text-[#2a1d00]" data-mos="premium-badge">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v16M4 12h16" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
                  </span>
                )}
              </div>
              <div class="flex min-w-0 flex-col gap-1">
                <span class="text-[10px] font-extrabold tracking-[0.1em] text-primary uppercase">{r.section?.title}</span>
                <span class="text-sm leading-[1.25] font-bold text-ink group-hover:text-primary">{r.title}</span>
                <span class="text-[11px] text-ink-4">
                  {a?.name} · {r.readTime}m
                </span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </aside>
)}
