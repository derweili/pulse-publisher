---
import type { VideoEmbedData } from "./types";

interface Props {
  block: VideoEmbedData;
  index: number;
}

const { block, index } = Astro.props;

// EmDash's embed block stores whatever URL an editor pastes — a normal
// YouTube/Vimeo share/watch link, not necessarily a pre-formatted `/embed/`
// URL — so this extracts the video ID the same way EmDash's own renderer
// does (src/components/Embed.astro) rather than assuming `block.url` is
// already iframe-ready.
const YOUTUBE_ID_PATTERN = /(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/;
const VIMEO_ID_PATTERN = /vimeo\.com\/(\d+)/;
const youtubeId = block.url.match(YOUTUBE_ID_PATTERN)?.[1];
const vimeoId = block.url.match(VIMEO_ID_PATTERN)?.[1];
const embedSrc = youtubeId
  ? `https://www.youtube.com/embed/${youtubeId}`
  : vimeoId
    ? `https://player.vimeo.com/video/${vimeoId}`
    : block.url;
---

<div class="relative my-[1.8em] aspect-video overflow-hidden rounded bg-ink" data-mos-block={index}>
  <iframe
    src={embedSrc}
    title="Embedded video"
    loading="lazy"
    allowfullscreen
    class="absolute inset-0 h-full w-full border-0"></iframe>
  <button
    type="button"
    class="absolute top-2.5 right-2.5 z-2 grid size-8 place-items-center rounded-full bg-ink/70 text-white transition-colors duration-200 hover:bg-ink"
    data-lightbox-trigger="video"
    data-src={block.url}
    aria-label="Expand video"
    title="Expand video"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" /></svg>
  </button>
</div>
