---
import { renderInline, type TextBlock } from "./types";

interface Props {
  block: TextBlock;
  index: number;
}

const { block, index } = Astro.props;
const html = renderInline(block);
---

{
  block.style === "h2" ? (
    <h2 class="mt-[1.8em] mb-[0.6em] text-[calc(1.5rem*var(--reading-scale,1))] tracking-[-0.01em]" data-mos-block={index} set:html={html} />
  ) : block.style === "blockquote" ? (
    <blockquote
      class="my-[1.8em] border-l-4 border-primary pl-6 text-[calc(22px*var(--reading-scale,1))] leading-[1.4] font-semibold text-ink italic max-sm:text-[calc(19px*var(--reading-scale,1))]"
      data-mos-block={index}
      set:html={html}
    />
  ) : (
    <p class="my-[1.2em] text-[calc(1.125rem*var(--reading-scale,1))] leading-[1.7] text-ink-2 max-sm:text-[calc(17px*var(--reading-scale,1))]" data-mos-block={index} set:html={html} />
  )
}
