---
import Block from "./Block.astro";
import ImageBlock from "./ImageBlock.astro";
import { groupBlocks, renderInline, type BodyBlock } from "./types";
import VideoEmbed from "./VideoEmbed.astro";

interface Props {
  value: BodyBlock[];
  startIndex?: number;
}

const { value, startIndex = 0 } = Astro.props;
const items = groupBlocks(value, startIndex);
---

{
  items.map((item) => {
    if (item.kind === "list") {
      const Tag = item.listItem === "number" ? "ol" : "ul";
      return (
        <Tag class="my-[1.4em] list-none pl-0">
          {item.items.map(({ block, index }) => (
            <li
              class="relative mb-2.5 pl-[26px] text-[calc(17px*var(--reading-scale,1))] leading-relaxed text-ink-2 before:absolute before:top-[11px] before:left-0 before:h-0.5 before:w-3.5 before:bg-primary before:content-['']"
              data-mos-block={index}
              set:html={renderInline(block)}
            />
          ))}
        </Tag>
      );
    }
    if (item.kind === "block") return <Block block={item.block} index={item.index} />;
    if (item.kind === "imageBlock") return <ImageBlock block={item.block} index={item.index} />;
    return <VideoEmbed block={item.block} index={item.index} />;
  })
}
