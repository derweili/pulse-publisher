---
import { articlePath } from "../lib/paths";
import type { ArticleCardData } from "../lib/payload/fetch";

interface Props {
  articles: ArticleCardData[];
  title?: string;
  limit?: number;
}
const { articles, title = "Trending now", limit = 5 } = Astro.props;
const items = articles.slice(0, limit);
---

{items.length > 0 && (
  <aside class="flex flex-col gap-3">
    <h4 class="border-b-2 border-ink pb-2.5 text-xs font-extrabold tracking-[0.12em] text-ink-3 uppercase">{title}</h4>
    <ol class="flex flex-col gap-3.5">
      {items.map((a, i) => (
        <li>
          <a href={articlePath(a.slug)} class="group grid grid-cols-[28px_1fr] items-start gap-3">
            <span class="font-display text-[22px] leading-none text-primary">{i + 1}</span>
            <span class="text-sm leading-[1.3] font-bold text-ink group-hover:text-primary">{a.title}</span>
          </a>
        </li>
      ))}
    </ol>
  </aside>
)}
