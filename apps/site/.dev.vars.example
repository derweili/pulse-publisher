# Cloudflare Worker runtime secrets for local dev.
#
# Copy to `.dev.vars` and fill it in. Read by `astro dev` (via the Cloudflare
# adapter's `platformProxy`) and by `wrangler dev`/`npm run cf:preview` — it
# mirrors what you'd set in production with `wrangler secret put` or the
# Workers dashboard. Unlike `.env`, this is NOT inlined at build time: it's
# read per-request through `Astro.locals.runtime.env`, matching how the
# deployed Worker reads it. See `src/lib/emdash/client.ts`.

# Base URL of your local/deployed apps/cms ("pulse-cms"). Local dev:
# http://localhost:4322 (or whatever port `npm run cms:dev` picks — see
# apps/cms's astro dev output). Not a secret.
EMDASH_URL=http://localhost:4322

# pulse-cms personal access token. Create one in pulse-cms's admin
# (Settings → API tokens, or via `npx emdash` from apps/cms) scoped to
# content:read — apps/site only ever reads published content.
EMDASH_API_TOKEN=

# Shared secret for packages/emdash-revalidate-plugin's POSTs to
# POST /api/revalidate. Same value goes in apps/cms's REVALIDATE_SECRET
# (see apps/cms/.dev.vars.example) — this app checks it as
# `Authorization: Bearer <value>`. See docs/emdash-migration-plan.md.
REVALIDATE_SECRET=
