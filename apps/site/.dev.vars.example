# Cloudflare Worker runtime secrets/vars for local dev.
#
# Copy to `.dev.vars` and fill it in. Read by `astro dev` (via the Cloudflare
# adapter's `platformProxy`) and by `wrangler dev`/`npm run cf:preview` — it
# mirrors what you'd set in production with `wrangler secret put` (for the
# two secrets below) or `[vars]` in wrangler.toml (for PAYLOAD_API_URL).
# Unlike `.env`, this is NOT inlined at build time: it's read per-request
# through `Astro.locals.runtime.env`, matching how the deployed Worker reads
# it. See `src/lib/payload/client.ts`.

# apps/cms's public URL (e.g. http://localhost:3000 while running apps/cms
# locally, or its deployed URL). Not a secret — also set as a `[vars]` entry
# in wrangler.toml for production.
PAYLOAD_API_URL=http://localhost:3000

# Authenticates as the service account apps/cms's `onInit` bootstraps.
# Same value as apps/cms's PAYLOAD_SERVICE_API_KEY. See
# apps/cms/README.md ("Connecting apps/site").
PAYLOAD_API_KEY=

# Shared secret for the cache-purge webhook apps/cms sends to
# POST /api/revalidate. Same value as apps/cms's REVALIDATE_WEBHOOK_SECRET.
# See docs/cache-revalidation.md.
PAYLOAD_WEBHOOK_SECRET=
