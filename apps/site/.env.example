# Clerk authentication
# Get this value from https://dashboard.clerk.com → your app → API Keys
# This is the site's only Clerk build/runtime dependency: the site renders
# via SSR (see wrangler.toml), but auth still runs entirely client-side via
# Clerk's browser SDK — no CLERK_SECRET_KEY is needed.
PUBLIC_CLERK_PUBLISHABLE_KEY=

# Sanity CMS
# Project ID and dataset from https://sanity.io/manage → your project → Settings.
# These are build-time only (inlined into the client and server bundles by
# Vite) — not secrets, just not needed in the browser bundle beyond this.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Dated API version — see https://www.sanity.io/docs/api-versioning. Bump
# deliberately; don't just set it to "today" on every change.
PUBLIC_SANITY_API_VERSION=2025-02-01

# NOTE: SANITY_API_READ_TOKEN is NOT set here. The site renders via SSR on
# Cloudflare Workers (every page queries Sanity live, per request), so the
# read token is a Worker runtime secret instead of a build-time env var —
# see .dev.vars.example for local dev, and the README for production setup.
