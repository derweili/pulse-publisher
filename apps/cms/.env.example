# Postgres connection string. Any Postgres works (Neon, Supabase, Railway,
# Vercel Postgres, self-hosted) — this is the only required piece of
# infrastructure choice.
DATABASE_URI=postgres://user:password@host:5432/pulse

# Generate with `openssl rand -hex 32`. Used to sign admin sessions/tokens —
# changing it invalidates every existing session.
PAYLOAD_SECRET=

# The public URL this app is deployed at (e.g. https://cms.pulse.derweili.de
# or your Vercel URL). Used to build absolute media URLs so apps/site (a
# different app/origin) can hotlink them.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# S3-compatible object storage for uploaded media (hero images, avatars,
# inline body images). Works with Cloudflare R2, AWS S3, or any S3-compatible
# provider. Leave S3_BUCKET empty to fall back to local disk storage (fine
# for local dev, NOT fine for most serverless hosts — their filesystem is
# ephemeral).
S3_BUCKET=
S3_REGION=auto
# Only needed for a non-AWS S3-compatible endpoint, e.g. R2:
# https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bootstraps a service account (site@pulse.internal) on first boot, with this
# value as its API key — see README "Connecting apps/site". Set the exact
# same value as apps/site's PAYLOAD_API_KEY Worker secret.
PAYLOAD_SERVICE_API_KEY=

# Where apps/site's cache-purge webhook lives, and the shared secret used to
# sign requests to it — see docs/cache-revalidation.md. Same value as
# apps/site's PAYLOAD_WEBHOOK_SECRET Worker secret.
REVALIDATE_URL=https://pulse.derweili.de/api/revalidate
REVALIDATE_WEBHOOK_SECRET=
