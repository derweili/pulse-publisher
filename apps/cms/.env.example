# EmDash plugin-secret encryption key. Generate with:
#   npx emdash secrets generate --write .env
# Format: emdash_enc_v1_<43 base64url chars>. Keep this in a secret manager
# and a separate recovery backup — losing it makes encrypted plugin settings
# unreadable. In production this is a Worker secret instead:
#   wrangler secret put EMDASH_ENCRYPTION_KEY
EMDASH_ENCRYPTION_KEY=

# --- Build-time values for packages/emdash-revalidate-plugin ---------------
# These are read by astro.config.mjs at BUILD time (`process.env`), not as a
# Worker runtime secret via `wrangler secret put`. EmDash's native-plugin
# context has no `ctx.env` — plugin config is passed as plain arguments from
# astro.config.mjs — so there's no per-request runtime-secret injection path
# for a plugin to use here. Baking REVALIDATE_SECRET into the built Worker
# bundle is an accepted trade-off: the bundle is already a trusted deploy
# artifact, not something a reader can download. See
# docs/emdash-migration-plan.md and the plugin's own comment.

# Full URL of apps/site's revalidate endpoint, reached through the public
# edge (apps/site itself has no public URL by design — see CLAUDE.md).
# Production: https://pulse.derweili.de/api/revalidate
SITE_REVALIDATE_URL=

# Shared secret — must match apps/site's REVALIDATE_SECRET exactly.
REVALIDATE_SECRET=
